NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Stripe test-mode values while developing locally.
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# Public origin used in Stripe return URLs. Omit locally to use the request origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe plan wiring. All of these are MODE-SPECIFIC: a live `price_`/`prod_`
# id is a 404 against a test key and vice versa, so set them per deployment.
# Leave every one blank in test/local and checkout builds an inline price
# automatically.
#
# Production (live mode) values:
#   STRIPE_PLUS_PRICE_ID=price_1UFK1kDjVqlbEFhhiSFhuxcx
#   STRIPE_MAX_PRICE_ID=price_1UFJ7NDjVqlbEFhhMXypoVxp
#   STRIPE_PLUS_PRODUCT_ID=prod_VFokFhAwpxV0Px
#   STRIPE_MAX_PRODUCT_ID=prod_VFokXkBcqVGwEs
STRIPE_PLUS_PRICE_ID=
STRIPE_MAX_PRICE_ID=

# Only used to group the inline fallback price under an existing Product.
STRIPE_PLUS_PRODUCT_ID=
STRIPE_MAX_PRODUCT_ID=

# Last-resort fallback: hosted Payment Links, used only when a plan has no
# Price id. These cannot carry Checkout metadata, and a link stops working as
# soon as its underlying price is replaced.
#
# Current live links:
#   STRIPE_PLUS_PAYMENT_LINK=https://buy.stripe.com/4gM8wP3eu2nlcKj40vaR209
#   STRIPE_MAX_PAYMENT_LINK=https://buy.stripe.com/6oUcN55mC5zxdOn40vaR205
STRIPE_PLUS_PAYMENT_LINK=
STRIPE_MAX_PAYMENT_LINK=

# Resend, used for the "ask a parent to pay" email. RESEND_FROM_EMAIL must be on
# a domain verified in the Resend dashboard or sends are rejected.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Tutormigo <hello@tutormigo.com>
